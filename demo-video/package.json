{
  "name": "fastpath64-demo-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "data": "tsx scripts/prepare-data.ts",
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "still": "npm run data && remotion still src/index.ts FastPath64Demo out/frame.png --frame=",
    "render": "npm run data && remotion render src/index.ts FastPath64Demo out/fastpath64-demo.mp4",
    "check": "npm run data && npm run typecheck"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.490",
    "@remotion/cli": "4.0.490",
    "@remotion/renderer": "4.0.490",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.490"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
