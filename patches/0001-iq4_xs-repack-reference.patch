diff --git a/ggml/src/ggml-cpu/repack.cpp b/ggml/src/ggml-cpu/repack.cpp
index f18758f..d8e72df 100644
--- a/ggml/src/ggml-cpu/repack.cpp
+++ b/ggml/src/ggml-cpu/repack.cpp
@@ -1195,6 +1195,61 @@ void ggml_gemv_iq4_nl_8x8_q8_0_generic(int n, float * GGML_RESTRICT s, size_t bs
     }
 }
 
+// IQ4_XS reference kernels.
+//
+// Layout recap: make_block_iq4_xsx8() interleaves the eight rows' quants eight bytes at a time,
+// so row j's qs byte (8*c + i) lands at qs[64*c + 8*j + i]. Each iq4_xs sub-block covers 32
+// elements in 16 bytes: low nibbles feed elements 0..15, high nibbles feed elements 16..31,
+// both scaled by the same 6-bit sub-block scale (ls - 32). Unlike q4_K there is no min term,
+// so no bsums/dmin correction is needed.
+void ggml_gemv_iq4_xs_8x8_q8_K_generic(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int qk = QK_K;
+    const int nb = n / qk;
+    const int ncols_interleaved = 8;
+    const int blocklen = 8;
+
+    assert (n % qk == 0);
+    assert (nc % ncols_interleaved == 0);
+
+    UNUSED(bs);
+    UNUSED(nr);
+
+    float sumf[8];
+
+    const block_q8_K * a_ptr = (const block_q8_K *) vy;
+    for (int x = 0; x < nc / ncols_interleaved; x++) {
+        const block_iq4_xsx8 * b_ptr = (const block_iq4_xsx8 *) vx + (x * nb);
+
+        for (int j = 0; j < ncols_interleaved; j++) {
+            sumf[j] = 0.0;
+        }
+        for (int l = 0; l < nb; l++) {
+            for (int sb = 0; sb < QK_K / 32; sb++) {
+                for (int j = 0; j < ncols_interleaved; j++) {
+                    const int ls = ((b_ptr[l].scales_l[j * (QK_K / 64) + sb / 2] >> (4 * (sb % 2))) & 0xF)
+                                 | (((b_ptr[l].scales_h[j] >> (2 * sb)) & 3) << 4);
+                    int sumi = 0;
+                    for (int c = 0; c < 2; c++) {
+                        const int chunk = 2 * sb + c;
+                        for (int i = 0; i < blocklen; ++i) {
+                            const uint8_t q = b_ptr[l].qs[chunk * ncols_interleaved * blocklen + j * blocklen + i];
+                            const int v0 = kvalues_iq4nl[q & 0x0F];
+                            const int v1 = kvalues_iq4nl[q >> 4];
+                            const int e  = sb * 32 + c * blocklen + i;
+                            sumi += v0 * a_ptr[l].qs[e];
+                            sumi += v1 * a_ptr[l].qs[e + 16];
+                        }
+                    }
+                    sumf[j] += (float) (sumi * (ls - 32)) * GGML_CPU_FP16_TO_FP32(b_ptr[l].d[j]) * a_ptr[l].d;
+                }
+            }
+        }
+        for (int j = 0; j < ncols_interleaved; j++) {
+            s[x * ncols_interleaved + j] = sumf[j];
+        }
+    }
+}
+
 void ggml_gemv_mxfp4_4x4_q8_0_generic(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
     const int qk = QK8_0;
     const int nb = n / qk;
@@ -2189,6 +2244,71 @@ void ggml_gemm_iq4_nl_8x8_q8_0_generic(int n, float * GGML_RESTRICT s, size_t bs
     }
 }
 
+// Maps element e of activation row m onto the block_q8_Kx4 interleaved layout. Four rows share
+// each 64-element group: [group][8-byte chunk][row][8 values], with the upper half of every
+// 64-element group displaced by 128. Derived from, and cross-checked against, the indexing in
+// ggml_gemm_q4_K_8x8_q8_K_generic().
+static inline int q8_Kx4_offset(int e, int m) {
+    const int g    = e / 64;
+    const int r    = e % 64;
+    const int half = (r >= 32) ? 128 : 0;
+    const int rr   = (r >= 32) ? (r - 32) : r;
+    return g * 256 + (rr / 8) * 32 + m * 8 + (rr % 8) + half;
+}
+
+void ggml_gemm_iq4_xs_8x8_q8_K_generic(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int qk = QK_K;
+    const int nb = n / qk;
+    const int ncols_interleaved = 8;
+    const int blocklen = 8;
+
+    assert (n % qk == 0);
+    assert (nr % 4 == 0);
+    assert (nc % ncols_interleaved == 0);
+
+    float sumf[4][8];
+
+    for (int y = 0; y < nr / 4; y++) {
+        const block_q8_Kx4 * a_ptr = (const block_q8_Kx4 *) vy + (y * nb);
+        for (int x = 0; x < nc / ncols_interleaved; x++) {
+            const block_iq4_xsx8 * b_ptr = (const block_iq4_xsx8 *) vx + (x * nb);
+            for (int m = 0; m < 4; m++) {
+                for (int j = 0; j < ncols_interleaved; j++) {
+                    sumf[m][j] = 0.0;
+                }
+            }
+            for (int l = 0; l < nb; l++) {
+                for (int sb = 0; sb < QK_K / 32; sb++) {
+                    for (int j = 0; j < ncols_interleaved; j++) {
+                        const int ls = ((b_ptr[l].scales_l[j * (QK_K / 64) + sb / 2] >> (4 * (sb % 2))) & 0xF)
+                                     | (((b_ptr[l].scales_h[j] >> (2 * sb)) & 3) << 4);
+                        for (int m = 0; m < 4; m++) {
+                            int sumi = 0;
+                            for (int c = 0; c < 2; c++) {
+                                const int chunk = 2 * sb + c;
+                                for (int i = 0; i < blocklen; ++i) {
+                                    const uint8_t q = b_ptr[l].qs[chunk * ncols_interleaved * blocklen + j * blocklen + i];
+                                    const int v0 = kvalues_iq4nl[q & 0x0F];
+                                    const int v1 = kvalues_iq4nl[q >> 4];
+                                    const int e  = sb * 32 + c * blocklen + i;
+                                    sumi += v0 * a_ptr[l].qs[q8_Kx4_offset(e, m)];
+                                    sumi += v1 * a_ptr[l].qs[q8_Kx4_offset(e + 16, m)];
+                                }
+                            }
+                            sumf[m][j] += (float) (sumi * (ls - 32)) * GGML_CPU_FP16_TO_FP32(b_ptr[l].d[j]) * a_ptr[l].d[m];
+                        }
+                    }
+                }
+            }
+            for (int m = 0; m < 4; m++) {
+                for (int j = 0; j < ncols_interleaved; j++) {
+                    s[(y * 4 + m) * bs + x * ncols_interleaved + j] = sumf[m][j];
+                }
+            }
+        }
+    }
+}
+
 void ggml_gemm_mxfp4_4x4_q8_0_generic(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
     const int qk = QK8_0;
     const int nb = n / qk;
@@ -2910,6 +3030,44 @@ static block_q4_Kx8 make_block_q4_Kx8(block_q4_K * in, unsigned int blck_size_in
     return out;
 }
 
+static block_iq4_xsx8 make_block_iq4_xsx8(block_iq4_xs * in, unsigned int blck_size_interleave) {
+    block_iq4_xsx8 out;
+
+    // iq4_xs carries a single super-block scale plus 6-bit sub-block scales split across
+    // scales_h (2 bits) and scales_l (4 bits). Those stay in their source encoding here and
+    // are decoded in the kernel; the interleaved block has no spare room to pre-decode them.
+    for (int i = 0; i < 8; i++) {
+        out.d[i] = in[i].d;
+    }
+
+    for (int i = 0; i < 8; i++) {
+        out.scales_h[i] = in[i].scales_h;
+    }
+
+    for (int i = 0; i < 8; i++) {
+        for (int j = 0; j < QK_K / 64; j++) {
+            out.scales_l[i * (QK_K / 64) + j] = in[i].scales_l[j];
+        }
+    }
+
+    const int end = QK_K * 4 / blck_size_interleave;
+
+    // Interleave the quants by taking blck_size_interleave bytes at a time, round-robin over
+    // the eight source rows - identical to the q4_K path, since both store QK_K/2 bytes a row.
+    for (int i = 0; i < end; ++i) {
+        int src_id = i % 8;
+        int src_offset = (i / 8) * blck_size_interleave;
+        int dst_offset = i * blck_size_interleave;
+
+        // buffer large enough for the max interleave block size (8 bytes)
+        uint64_t elems;
+        memcpy(&elems, &in[src_id].qs[src_offset], blck_size_interleave);
+        memcpy(&out.qs[dst_offset], &elems, blck_size_interleave);
+    }
+
+    return out;
+}
+
 static block_q4_Kx16 make_block_q4_Kx16(block_q4_K * in, unsigned int blck_size_interleave) {
     block_q4_Kx16 out;
     //Delta(scale) and dmin values of the 16 Q4_K structures are copied onto the output interleaved structure
@@ -3259,6 +3417,37 @@ static int repack_q4_K_to_q4_K_8_bl(struct ggml_tensor * t, int interleave_block
     GGML_UNUSED(data_size);
 }
 
+static int repack_iq4_xs_to_iq4_xs_8_bl(struct ggml_tensor * t, int interleave_block, const void * GGML_RESTRICT data, size_t data_size) {
+    GGML_ASSERT(t->type == GGML_TYPE_IQ4_XS);
+    GGML_ASSERT(interleave_block == 8);
+    constexpr int nrows_interleaved = 8;
+
+    block_iq4_xsx8 * dst = (block_iq4_xsx8 *)t->data;
+    const block_iq4_xs * src = (const block_iq4_xs *) data;
+    block_iq4_xs dst_tmp[8];
+    int nrow = ggml_nrows(t);
+    int nblocks = t->ne[0] / QK_K;
+
+    GGML_ASSERT(data_size == nrow * nblocks * sizeof(block_iq4_xs));
+
+    if (t->ne[1] % nrows_interleaved != 0 || t->ne[0] % 8 != 0) {
+        return -1;
+    }
+
+    for (int b = 0; b < nrow; b += nrows_interleaved) {
+        for (int64_t x = 0; x < nblocks; x++) {
+            for (int i = 0; i < nrows_interleaved; i++) {
+                dst_tmp[i] = src[x + i * nblocks];
+            }
+            *dst++ = make_block_iq4_xsx8(dst_tmp, interleave_block);
+        }
+        src += nrows_interleaved * nblocks;
+    }
+    return 0;
+
+    GGML_UNUSED(data_size);
+}
+
 static int repack_q4_K_to_q4_K_16_bl(struct ggml_tensor * t, int interleave_block, const void * GGML_RESTRICT data, size_t data_size) {
     GGML_ASSERT(t->type == GGML_TYPE_Q4_K);
     constexpr int nrows_interleaved = 16;
@@ -3885,6 +4074,10 @@ template <> int repack<block_q4_K, 4, 8>(struct ggml_tensor * t, const void * da
     return repack_q4_K_to_q4_K_8_bl(t, 4, data, data_size);
 }
 
+template <> int repack<block_iq4_xs, 8, 8>(struct ggml_tensor * t, const void * data, size_t data_size) {
+    return repack_iq4_xs_to_iq4_xs_8_bl(t, 8, data, data_size);
+}
+
 template <> int repack<block_q2_K, 8, 8>(struct ggml_tensor * t, const void * data, size_t data_size) {
     return repack_q2_K_to_q2_K_8_bl(t, 8, data, data_size);
 }
@@ -3991,6 +4184,10 @@ template <> void gemv<block_q4_K, 8, 8, GGML_TYPE_Q8_K>(int n, float * s, size_t
     ggml_gemv_q4_K_8x8_q8_K(n, s, bs, vx, vy, nr, nc);
 }
 
+template <> void gemv<block_iq4_xs, 8, 8, GGML_TYPE_Q8_K>(int n, float * s, size_t bs, const void * vx, const void * vy, int nr, int nc) {
+    ggml_gemv_iq4_xs_8x8_q8_K(n, s, bs, vx, vy, nr, nc);
+}
+
 template <> void gemv<block_q5_K, 4, 8, GGML_TYPE_Q8_K>(int n, float * s, size_t bs, const void * vx, const void * vy, int nr, int nc) {
     ggml_gemv_q5_K_8x4_q8_K(n, s, bs, vx, vy, nr, nc);
 }
@@ -4088,6 +4285,10 @@ template <> void gemm<block_q4_K, 8, 8, GGML_TYPE_Q8_K>(int n, float * s, size_t
     ggml_gemm_q4_K_8x8_q8_K(n, s, bs, vx, vy, nr, nc);
 }
 
+template <> void gemm<block_iq4_xs, 8, 8, GGML_TYPE_Q8_K>(int n, float * s, size_t bs, const void * vx, const void * vy, int nr, int nc) {
+    ggml_gemm_iq4_xs_8x8_q8_K(n, s, bs, vx, vy, nr, nc);
+}
+
